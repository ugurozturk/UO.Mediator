{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Demo: UO.Mediator.Demo",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-demo",
            "program": "${workspaceFolder}/demo/UO.Mediator.Demo/bin/Debug/net10.0/UO.Mediator.Demo.dll",
            "args": [],
            "cwd": "${workspaceFolder}/demo/UO.Mediator.Demo",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5199"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            }
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}
