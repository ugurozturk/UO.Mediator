{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-demo",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/demo/UO.Mediator.Demo/UO.Mediator.Demo.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "pack-release",
            "type": "shell",
            "command": "dotnet pack src/UO.Mediator/UO.Mediator.csproj -c Release && dotnet pack src/UO.Mediator.ApiExplorer/UO.Mediator.ApiExplorer.csproj -c Release && dotnet pack src/UO.Mediator.Shared/UO.Mediator.Shared.csproj -c Release",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "group": "build"
        }
    ]
}
