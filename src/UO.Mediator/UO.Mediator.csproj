<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>UO.Mediator</RootNamespace>
    <AssemblyName>UO.Mediator</AssemblyName>

    <!-- NuGet packaging -->
    <IsPackable>true</IsPackable>
    <PackageId>UO.Mediator</PackageId>
    <Version>2.4.1</Version>
    <Authors>UO</Authors>
    <Company>UO</Company>
    <Description>Lightweight request dispatcher / mediator for .NET applications.</Description>
    <PackageTags>mediator;request;dispatcher;uo</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ugurozturk/UO.Mediator</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ugurozturk/UO.Mediator</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UO.Mediator.Shared\UO.Mediator.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
