<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>UO.Mediator.Shared</RootNamespace>
    <AssemblyName>UO.Mediator.Shared</AssemblyName>

    <!-- NuGet packaging -->
    <IsPackable>true</IsPackable>
    <PackageId>UO.Mediator.Shared</PackageId>
    <Version>2.4.0</Version>
    <Authors>UO</Authors>
    <Company>UO</Company>
    <Description>Lightweight request dispatcher / mediator for .NET applications.</Description>
    <PackageTags>mediator;request;dispatcher;uo</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ugurozturk/UO.Mediator.Shared</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ugurozturk/UO.Mediator.Shared</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
