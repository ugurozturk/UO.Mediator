<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>UO.Mediator.ApiExplorer.Generators</RootNamespace>
    <AssemblyName>UO.Mediator.ApiExplorer</AssemblyName>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- Analyzer-only package: the dll ships under analyzers/, so lib/ref folders are empty by design -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>

    <!-- NuGet packaging -->
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <PackageId>UO.Mediator.ApiExplorer</PackageId>
    <Authors>UO</Authors>
    <Company>UO</Company>
    <Description>Compile-time ASP.NET Core controller generator for UO.Mediator requests.</Description>
    <PackageTags>mediator;aspnetcore;controller;source-generator;uo</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ugurozturk/UO.Mediator</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ugurozturk/UO.Mediator</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)$(AssemblyName).dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
    <None Include="buildTransitive/UO.Mediator.ApiExplorer.props"
          Pack="true"
          PackagePath="buildTransitive/UO.Mediator.ApiExplorer.props" />
    <None Include="README.md"
          Pack="true"
          PackagePath="\" />
  </ItemGroup>

</Project>
