<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Uozturk.Mediator.ApiExplorer.Generators</RootNamespace>
    <AssemblyName>Uozturk.Mediator.ApiExplorer</AssemblyName>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

    <!-- NuGet packaging -->
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <PackageId>Uozturk.Mediator.ApiExplorer</PackageId>
    <Version>2.1.0</Version>
    <Authors>uozturk</Authors>
    <Company>uozturk</Company>
    <Description>Compile-time ASP.NET Core controller generator for Uozturk.Mediator requests.</Description>
    <PackageTags>mediator;aspnetcore;controller;source-generator;uozturk</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/uozturk/Uozturk.Mediator</PackageProjectUrl>
    <RepositoryUrl>https://github.com/uozturk/Uozturk.Mediator</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)$(AssemblyName).dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
    <None Include="buildTransitive/Uozturk.Mediator.ApiExplorer.props"
          Pack="true"
          PackagePath="buildTransitive/Uozturk.Mediator.ApiExplorer.props" />
    <None Include="README.md"
          Pack="true"
          PackagePath="\" />
  </ItemGroup>

</Project>
